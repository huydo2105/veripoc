    "api:dev": "node apps/api/start.mjs",
    "test:api": "node --test apps/api/server.test.mjs",
    "web:dev": "npm run dev --workspace @veripoc/web",
    "web:build": "npm run build --workspace @veripoc/web",
    "web:typecheck": "npm run typecheck --workspace @veripoc/web",
    "web:lint": "npm run lint --workspace @veripoc/web",
    "test:web": "npm run test:unit --workspace @veripoc/web"
